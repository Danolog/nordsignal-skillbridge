# Database (PostgreSQL — Docker locally, Neon on production)
DATABASE_URL=postgresql://user:pass@localhost:5432/skillbridge

# Better Auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Faculty panel — hasło PER KAMPUS (K3). Ustaw zmienną dla każdego aktywnego partnera.
# Nazwa: FACULTY_PASSWORD_<SLUG_WIELKIMI_Z_PODKREŚLENIAMI>. W produkcji ≥16 znaków.
# Nieustawiony kampus = brak logowania do niego (nie blokuje pozostałych).
FACULTY_PASSWORD_WSB_MERITO_SZCZECIN=
FACULTY_PASSWORD_WSB_MERITO_WARSZAWA=

# Anthropic
ANTHROPIC_API_KEY=

# Upstash Redis (rate limiting — opcjonalne lokalnie, wymagane na produkcji)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Feature flags (1.1) — „deploy ≠ release". Każda domyślnie WYŁĄCZONA; zapala
# truthy wartość: 1 / true / on. Źródło prawdy: src/lib/flags.ts (FLAGS).
FLAG_PROACTIVE_MARKET_REFRESH=
FLAG_MARKET_GAP_NOTIFICATIONS=
FLAG_ADVISOR_MEMORY=
FLAG_HUMAN_REVIEW_QUEUE=
FLAG_CAREER_MODEL_FROM_DB=
# B6/1.8 (ADR-012): bieg ukrytych test-suites w Vercel Sandbox. Na Vercelu SDK
# uwierzytelnia się OIDC automatycznie; lokalnie: `vercel env pull` (VERCEL_OIDC_TOKEN).
FLAG_SANDBOX_RUNNER=

# AG.3: sekret trasy POST /api/market-refresh/ingest (upload CSV rynku do stagingu).
# Wymagany, gdy FLAG_PROACTIVE_MARKET_REFRESH=1; brak = trasa zamknięta.
MARKET_REFRESH_TOKEN=

# B8/1.3 (ADR-011): hasło operatora jakości (kolejka recenzji, cross-tenant).
# Wymagane, gdy FLAG_HUMAN_REVIEW_QUEUE=1; brak = logowanie operatora zamknięte.
# Produkcja: min. 16 znaków (walidowane przy logowaniu).
OPERATOR_PASSWORD=
