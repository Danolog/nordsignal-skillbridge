# Database (PostgreSQL — Docker locally, Neon on production)
DATABASE_URL=postgresql://user:pass@localhost:5432/skillbridge

# Better Auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Faculty panel — hasło PER KAMPUS (K3). Ustaw zmienną dla każdego aktywnego partnera.
# Nazwa: FACULTY_PASSWORD_<SLUG_WIELKIMI_Z_PODKREŚLENIAMI>. W produkcji ≥16 znaków.
# Nieustawiony kampus = brak logowania do niego (nie blokuje pozostałych).
FACULTY_PASSWORD_WSB_MERITO_SZCZECIN=
FACULTY_PASSWORD_WSB_MERITO_WARSZAWA=

# Anthropic
ANTHROPIC_API_KEY=

# Upstash Redis (rate limiting — opcjonalne lokalnie, wymagane na produkcji)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Feature flags (1.1) — „deploy ≠ release". Każda domyślnie WYŁĄCZONA; zapala
# truthy wartość: 1 / true / on. Źródło prawdy: src/lib/flags.ts (FLAGS).
FLAG_PROACTIVE_MARKET_REFRESH=
FLAG_MARKET_GAP_NOTIFICATIONS=
FLAG_ADVISOR_MEMORY=
FLAG_HUMAN_REVIEW_QUEUE=
FLAG_CAREER_MODEL_FROM_DB=
# B6/1.8 (ADR-012): bieg ukrytych test-suites w Vercel Sandbox. Na Vercelu SDK
# uwierzytelnia się OIDC automatycznie; lokalnie: `vercel env pull` (VERCEL_OIDC_TOKEN).
FLAG_SANDBOX_RUNNER=
# A5/1.11–1.12: diagnoza zamiast samooceny (trasy /api/assessment/*).
# Przed zapaleniem na prod: migracja 0030.
FLAG_DIAGNOSTIC_ASSESSMENT=
# C11/1.13–1.14: tutor sokratyczny w widoku projektu (trasy /api/projects/[id]/tutor).
# Przed zapaleniem na prod: migracja 0031.
FLAG_SOCRATIC_TUTOR=
# B7/1.16 (ADR-013): obrona ustna bramkująca 'verified'. Przed zapaleniem: migracja 0032.
FLAG_VIVA_DEFENSE=
# 1.17 — śledzenie placement (zgoda RODO + baseline + zdarzenia)
FLAG_PLACEMENT_TRACKING=
# 1.18 — rytm nauki (deklaracja, streak, check-iny, alert zastoju)
FLAG_STUDY_RHYTHM=
# 1E — ścieżka curriculum: drabina modułów z prerekwizytami blokującymi (ADR-014)
FLAG_CURRICULUM_PATH=
# Blok C planu napraw (D1): paszport wyłącznie ze zweryfikowanych projektów (bramkuje odczyt)
FLAG_PASSPORT_VERIFIED_ONLY=
# MIS.1 (plan 13): sonda pewności przed odpowiedzią w drabinie (cecha FSRS / kalibracja)
FLAG_CONFIDENCE_PROBE=
# MIS.3 (plan 13): prywatny panel świeżości/kontekstów kredencjałów (wymaga PASSPORT_VERIFIED_ONLY=1)
FLAG_PASSPORT_FRESHNESS=
# 1E.3 (ADR-014 D3): mastery gate — egzamin modułowy (progresja wewnętrzna). Nie włączać przed bankiem C1 i tutorem 1.13
FLAG_MASTERY_GATE=
# 1E.4: powtórki rozłożone w czasie (FSRS, ts-fsrs), stan per student × koncept. Off = trasy /api/review/* 404, zero wierszy review_states/review_logs
FLAG_SPACED_REPETITION=
# 1E.7: placement z diagnozy — wynik diagnozy OTWIERA prefiks drabiny (egzamin nadal ZALICZA).
# Off = hook po domknięciu diagnozy nie odpala, zero wierszy curriculum_placements.
# Zapłon TYLKO razem z FLAG_MASTERY_GATE=1 (droga „test out" = warunek nośny A22-2, RoPA #5).
# ⚠ To NIE jest zalecenie — od 1E.7 L4 wymóg jest EGZEKWOWANY w kodzie (`requires`
# w src/lib/flags.ts): przy FLAG_MASTERY_GATE zgaszonym ta flaga zostaje WYŁĄCZONA
# mimo zapalonego env, a w logu pojawia się wpis [flags.requires].
FLAG_PLACEMENT_DIAGNOSTIC=
# E1b (RODO art. 17): ścieżka usunięcia konta przez studenta.
# Off = /api/auth/delete-user odpowiada 404, konto bez zmian.
# ⚠ ZAPŁON MA WŁASNY RUNBOOK — `docs/runbooks/zaplon-flagi-usuwania-konta.md`
# (właściciel: Ethan). Osiem bramek, nie jedna. Nie zapalaj bez przejścia listy.
FLAG_ACCOUNT_DELETION=

# E4: klauzula art. 13 RODO w interfejsie — strona /prywatnosc + odnośnik przy rejestracji.
# Off = trasa 404, odnośnik się nie renderuje.
# ⚠ NIE ZAPALAĆ przed kompletem warunków wejścia w życie z sekcji Z-2 dokumentu
# docs/legal/klauzula-informacyjna-art13.md (CAŁA tabela, nie wybrane wiersze) —
# klauzula obiecuje prawa, a obietnica prawa, którego nie umiemy wykonać, jest gorsza
# niż brak klauzuli. Zapłon = decyzja Darka po sign-offie, nie krok wdrożeniowy.
# W-1: bez zapalonego FLAG_ACCOUNT_DELETION ta flaga zostaje WYŁĄCZONA mimo
# zapalonego env (sprzężenie `requires` w src/lib/flags.ts, wpis w logu [flags.requires]).
FLAG_PRIVACY_NOTICE_ART13=

# Fala 2 (B2): strona pod MARTWYM ODNOŚNIKIEM paszportu — /passport/[id] dla
# nieistniejącego identyfikatora pokazuje CZĘŚĆ I dokumentu
# docs/product/zasada-odpowiedzi-dla-pracodawcy.md zamiast wbudowanego 404 po angielsku.
# Odbiorcą jest PRACODAWCA sprawdzający kandydata.
# Off = ekran minimalny po polsku, BEZ treści dokumentu.
# ⚠ UWAGA: zgaszona flaga NIE przywraca wbudowanego 404 — pliku `not-found.tsx` nie da
# się „nie mieć" warunkowo. Świadome odstępstwo od „off = zero zmian", opisane w kodzie.
# ⚠ Zapłon = sign-off Darka: dokument mówi w imieniu firmy do osoby z zewnątrz.
FLAG_PASSPORT_NOT_FOUND_NOTICE=

# Fala 2 (C): regulamin pilotażu — strona /regulamin + WYMAGANE pole akceptacji przy
# rejestracji (walidacja po stronie serwera, zaczep `before` biblioteki uwierzytelniającej).
# Off = trasa 404, pole się nie renderuje, bramka przepuszcza rejestrację jak dziś.
# ⚠ Zapłon = sign-off Darka: dokument docs/product/regulamin-pilotazu.md jest v0.1 DRAFT
# i wiąże firmę wobec uczestnika.
# ⚠ LUKA DOWODOWA DO CZASU MIGRACJI (właściciel: Ethan): akceptacja jest EGZEKWOWANA,
# ale NIEUTRWALONA — nie zapisujemy znacznika czasu ani wersji przy koncie, więc nie
# umiemy wykazać po fakcie, kto i na co się zgodził (zamówienie Sophii R-6 pkt 2).
# ⚠ Bramka NIE obejmuje rejestracji przez Google (inna trasa) — patrz signup/page.tsx.
FLAG_PILOT_TERMS=

# AG.3: sekret trasy POST /api/market-refresh/ingest (upload CSV rynku do stagingu).
# Wymagany, gdy FLAG_PROACTIVE_MARKET_REFRESH=1; brak = trasa zamknięta.
MARKET_REFRESH_TOKEN=

# 1E.6b (ADR-015): sekret derywacji KODU ATOMU dla labów curriculum.
#   kod_atomu = HMAC(LAB_TOKEN_SECRET, studentId:itemId)[:10]
# Student przepisuje kod atomu do komórki-pieczątki w notebooku Colab; pieczątka
# podpisuje nim ładunek z wyliczonymi wartościami, a serwer je weryfikuje.
#
# FAIL-CLOSED: brak sekretu (albo krótszy niż 16 znaków) ⇒ labów NIE DA SIĘ
# zaliczyć (trasa complete → 501), ale strony pozycji nadal się renderują.
# Wymagany, gdy FLAG_CURRICULUM_PATH=1 i drabina ma być przechodnia.
#
# ⚠ To NIE jest sekret w sensie kryptograficznym — funkcja podpisu jest widoczna
# w komórce notebooka, więc student może policzyć podpis ręcznie. Pełni rolę
# sumy kontrolnej (wykrywa literówkę, blokuje wklejenie tokenu kolegi).
# Rotacja unieważnia tokeny W OBIEGU, ale NIE postęp (ten jest w bazie).
# Generowanie: openssl rand -base64 32
LAB_TOKEN_SECRET=

# B8/1.3 (ADR-011): hasło operatora jakości (kolejka recenzji, cross-tenant).
# Wymagane, gdy FLAG_HUMAN_REVIEW_QUEUE=1; brak = logowanie operatora zamknięte.
# Produkcja: min. 16 znaków (walidowane przy logowaniu).
OPERATOR_PASSWORD=
