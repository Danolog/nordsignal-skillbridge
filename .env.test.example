# .env.test.example — szablon zmiennych dla lokalnej / kontenerowej bazy testowej.
#
# Skopiuj do .env.test i uzupełnij własne wartości.
# .env.test jest w .gitignore — NIGDY nie commituj pliku z realnymi sekretami.
# Ten plik (.env.test.example) jest bezpieczny do commitowania — ZERO realnych sekretów.
#
# Host w DATABASE_URL MUSI być localhost lub 127.0.0.1 (patrz tools/assert-test-db.ts).
# NIE używaj tu connection stringa z Neon prod.

# Connection string lokalnej / kontenerowej bazy testowej
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/skillbridge_test

# Alias używany przez seed-e2e.ts i run-e2e-dbwrite.ps1 (może być taki sam jak DATABASE_URL)
E2E_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/skillbridge_test

# Konta testowe tworzone przez seed-e2e.ts (better-auth, realny hash hasła)
E2E_TEST_EMAIL=e2e-main@example.com
E2E_TEST_PASSWORD=Test1234!e2e
E2E_TEST_EMAIL_B4=e2e-b4@example.com
E2E_TEST_PASSWORD_B4=Test1234!e2e

# Klucz sekretu better-auth (dowolny ciąg ≥32 bajtów, tylko do testów)
BETTER_AUTH_SECRET=replace-me-with-32-byte-test-secret-here
BETTER_AUTH_URL=http://localhost:3000

# ANTHROPIC_API_KEY — opcjonalny, tylko dla testów @llm (B0/B4)
# Bez klucza testy LLM pomijają się automatycznie.
# ANTHROPIC_API_KEY=sk-ant-...

# Ustaw 1, jeśli celowo używasz dedykowanej gałęzi Neon testowej (nie prod).
# Guard assert-test-db przepuści zdalny host + pokaże ostrzeżenie.
# E2E_ALLOW_REMOTE=1
