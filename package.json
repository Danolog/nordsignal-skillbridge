{
	"name": "skillbridge-ai",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@10.29.2",
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"start": "next start",
		"lint": "biome check .",
