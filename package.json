{
	"name": "skillbridge-ai",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@10.29.2",
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"start": "next start",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest --project unit",
		"test:run": "vitest run --project unit",
		"test:integration": "vitest run --project integration",
		"test:evals": "vitest run --project evals",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "bash tests/e2e/run-all.sh",
		"deps:scan": "pnpm audit --audit-level high",
		"secrets:scan-local": "bash tools/scan-local-secrets.sh",
		"prepare": "git config core.hooksPath .githooks || echo 'UWAGA: nie udalo sie uzbroic bramki skanu sekretow (core.hooksPath). Bramka NIE dziala. Napraw: git config core.hooksPath .githooks — patrz docs/runbooks/skan-sekretow-lokalnych.md' >&2",
		"test:e2e:pw": "playwright test",
		"test:e2e:pw:safe": "playwright test --grep @safe",
		"test:e2e:pw:dbwrite": "playwright test --grep @dbwrite",
		"seed:e2e": "tsx tools/seed-e2e.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx tools/db-guard-migrate.ts",
		"db:preflight": "tsx tools/prod-journal-check.ts",
		"db:migrate:test": "tsx tools/migrate-test.ts",
		"db:push": "tsx tools/db-guard-push.ts",
		"db:studio": "tsx tools/db-guard-studio.ts",
		"db:seed": "tsx tools/db-guard-seed.ts",
		"db:ingest-career-model": "tsx tools/ingest-career-model.ts",
		"content:pack-curriculum": "tsx tools/pack-curriculum-atoms.ts",
		"content:build-notebooks": "tsx tools/build-notebooks.ts",
		"content:build-sonda": "tsx tools/build-sonda-srodowiska.ts",
		"srodowisko:piny": "tsx tools/srodowisko-colab.ts --piny",
		"srodowisko:bramka": "tsx tools/srodowisko-colab.ts --bramka",
		"srodowisko:zapisz-sonde": "tsx tools/zapisz-sonde.ts",
		"srodowisko:inwentarz": "tsx tools/content/notebooks/inwentarz-cytatow.ts",
		"db:ingest-curriculum": "tsx tools/ingest-curriculum.ts",
		"db:ingest-question-bank": "tsx tools/ingest-question-bank.ts",
		"db:ingest-exam-bank": "tsx tools/ingest-exam-bank.ts"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^3.0.58",
		"@ai-sdk/react": "^3.0.118",
		"@rollup/rollup-linux-x64-gnu": "^4.62.4",
		"@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
		"@upstash/ratelimit": "^2.0.8",
		"@upstash/redis": "^1.38.2",
		"@vercel/sandbox": "^2.9.2",
		"@xyflow/react": "^12.11.2",
		"ai": "^6.0.116",
		"better-auth": "^1.6.26",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"html2canvas": "^1.4.1",
		"jspdf": "^4.2.1",
		"lucide-react": "^0.575.0",
		"next": "^16.3.0",
		"next-themes": "^0.4.6",
		"pdf-parse": "^2.4.5",
		"pg": "^8.22.0",
		"radix-ui": "^1.6.7",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-markdown": "^10.1.0",
		"recharts": "^3.10.1",
		"rehype-sanitize": "^6.0.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"ts-fsrs": "^5.4.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@biomejs/biome": "2.5.8",
		"@playwright/test": "^1.62.1",
		"@tailwindcss/postcss": "^4",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.3",
		"@types/node": "^26",
		"@types/pg": "^8.20.4",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6.0.5",
		"dotenv": "^17.4.2",
		"dotenv-cli": "^11.0.0",
		"drizzle-kit": "^0.31.10",
		"jsdom": "^30.0.1",
		"shadcn": "^4.16.2",
		"tailwindcss": "^4",
		"tsx": "^4.23.12",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.10"
	},
	"pnpm": {
		"overrides": {
			"@better-auth/sso": "1.6.23",
			"@better-auth/core": "1.6.23",
			"samlify": ">=2.13.0",
			"@xmldom/xmldom": ">=0.9.8",
			"undici": "^7.29.0",
			"kysely": "^0.28.17",
			"vite": "^7.3.5",
			"fast-uri": "^3.1.5",
			"sharp": "^0.35.0",
			"postcss": "^8.5.22",
			"postcss>nanoid": "^3.3.17",
			"hono": "^4.12.25",
			"@hono/node-server": "^1.19.14",
			"effect": "^3.21.2",
			"path-to-regexp": "^8.4.2",
			"lodash": "^4.18.1",
			"defu": "^6.1.7",
			"picomatch": "^4.0.4",
			"micromatch>picomatch": "^2.3.2",
			"brace-expansion": ">=5.0.9",
			"express-rate-limit>ip-address": "^10.3.1",
			"js-yaml": ">=5.2.2"
		}
	}
}
