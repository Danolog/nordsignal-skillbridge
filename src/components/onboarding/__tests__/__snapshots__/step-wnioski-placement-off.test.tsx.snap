exports[`StepWnioski — flaga placementu zgaszona (§12.6 wariant 1) > bez propu placementu render jest identyczny jak przed 1E.7 L6 (migawka sprzed zmiany) 1`] = `"<div class="space-y-6"><header class="space-y-2"><p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Wnioski</p><h2 class="font-heading text-2xl font-extrabold text-foreground">Masz plan. Zobacz, od czego zacząć.</h2><p class="text-sm text-foreground">Cel: <span class="font-medium">Data Scientist</span> — pokrywasz <span class="font-semibold text-ed-amber-text">33%</span> kompetencji, których szuka rynek dla tej roli.</p><p class="text-xs text-muted-foreground">To pokrycie umiejętności z ofert pracy, nie gwarancja zatrudnienia. Cel zmienisz w każdej chwili — na pulpicie jest „Zmień kierunek".</p></header><section class="rounded-lg border border-border bg-card p-4" aria-label="Pokrycie kompetencji rynku: 33 procent"><div class="relative h-2.5 rounded-full bg-ed-surface"><div class="absolute inset-y-0 left-0 rounded-full bg-ed-amber transition-all" style="width: 33%;"></div></div><div class="mt-2 flex items-center justify-between text-xs text-muted-foreground"><span>Twój start</span><span class="font-medium text-ed-amber-text">Teraz: 33%</span></div></section><section class="rounded-lg border border-border bg-card p-4 space-y-2" aria-label="Wynik testu kompetencji"><h3 class="font-heading text-base font-semibold text-foreground">Wynik testu — poziomy zmierzone, nie deklarowane</h3><ul class="space-y-1"><li class="flex items-center justify-between text-sm"><span class="text-foreground">Python</span><span class="font-medium text-ed-amber-text">mocna strona</span></li><li class="flex items-center justify-between text-sm"><span class="text-foreground">SQL</span><span class="font-medium text-destructive">do nauki (test niezaliczony)</span></li></ul><p class="text-xs text-muted-foreground">Bez pytań w banku (ocena własna, nie pomiar): Docker.</p></section><p class="rounded-md border border-ed-amber bg-ed-badge-bg px-3 py-2 text-xs text-ed-amber-text">Dane wstępne — mała próbka.</p><section class="space-y-4"><h3 class="font-heading text-lg font-semibold text-foreground">Obszary kompetencji dla tej roli</h3><div class="space-y-3"><div class="rounded-lg border border-border bg-card p-3"><div class="space-y-1"><div class="flex items-baseline justify-between gap-3"><h4 class="font-heading text-base font-semibold text-foreground">Dane i AI</h4><span class="inline-flex items-center whitespace-nowrap rounded-sm border border-ed-border bg-ed-badge-bg px-2 py-0.5 text-xs font-medium text-ed-amber-text">70% ofert grupy</span></div><p class="text-xs font-medium text-ed-amber-text">Masz 1 z 2</p><p class="text-sm text-muted-foreground">Rdzeń pracy z danymi.</p></div></div></div></section><section class="space-y-3"><div><h3 class="font-heading text-lg font-semibold text-foreground">Twój plan nauki</h3><p class="text-sm text-muted-foreground">Czego jeszcze nie zaznaczyłeś — to dobiera się projektami, w swoim tempie.</p></div><div class="grid grid-cols-3 gap-2"><div class="rounded-lg border bg-card px-3 py-3 text-center border-ed-amber"><div class="font-heading text-2xl font-extrabold text-ed-amber-text">1</div><div class="text-xs text-muted-foreground">Krytyczne</div></div><div class="rounded-lg border bg-card px-3 py-3 text-center border-border"><div class="font-heading text-2xl font-extrabold text-foreground">0</div><div class="text-xs text-muted-foreground">Ważne</div></div><div class="rounded-lg border bg-card px-3 py-3 text-center border-border"><div class="font-heading text-2xl font-extrabold text-foreground">1</div><div class="text-xs text-muted-foreground">Warto znać</div></div></div><p class="text-sm text-muted-foreground">Szacunkowo <span class="font-semibold text-foreground">11 h</span> nauki na start.</p><ul class="space-y-2"><li class="flex items-center justify-between gap-2 rounded-lg border border-border bg-card px-3 py-2"><span class="text-sm font-medium text-foreground">SQL<span class="ml-2 font-mono text-xs text-muted-foreground">90% ofert</span></span><span class="font-mono text-xs text-muted-foreground">8h</span></li><li class="flex items-center justify-between gap-2 rounded-lg border border-border bg-card px-3 py-2"><span class="text-sm font-medium text-foreground">Docker<span class="ml-2 font-mono text-xs text-muted-foreground">20% ofert</span></span><span class="font-mono text-xs text-muted-foreground">3h</span></li></ul></section><footer class="space-y-4 border-t border-border pt-5"><p class="text-xs text-muted-foreground">To Twoja własna deklaracja, nie ocena z zewnątrz. Poziomy może później potwierdzić wykładowca.</p><div class="flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:justify-between"><button data-slot="button" data-variant="default" data-size="default" class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*='size-'])]:size-4 shrink-0 [&amp;_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-4 py-2 has-[>svg]:px-3 ob-btn-primary gap-2">Przejdź do pulpitu<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-4 w-4" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></button><div class="flex flex-wrap gap-x-4 gap-y-1 text-sm"><button type="button" class="font-medium text-ed-amber-text hover:underline disabled:opacity-50">Zobacz analizę luk</button><button type="button" class="font-medium text-ed-amber-text hover:underline disabled:opacity-50">Wybierz pierwszy projekt</button></div></div></footer></div>"`;
